# Local dev: browser calls /api/* → Vite proxy forwards to http://localhost:8080/api/*
# (matches spring.mvc.servlet.path=/api). Omit env to fall back to http://localhost:8080 in apiBase.ts.
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api/*. Override when the backend is not on 8080,
# e.g. VITE_BACKEND_TARGET=http://localhost:8081
VITE_BACKEND_TARGET=http://localhost:8081
